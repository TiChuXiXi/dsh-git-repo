# 依赖
node_modules/

# 构建产物（仅当后续改用 TS + tsdown 时出现）
dist/

# 注意：本插件是零构建路线，lib/client.js 是浏览器半区的产物本体（手写、直接提交），绝不能忽略 lib/

# 日志与临时文件
*.log
npm-debug.log*
pnpm-debug.log*
.npm-cache-tmp/
.npm-cache/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# 本地环境变量
.env
.env.local

# npm 令牌（内容为 //registry.npmjs.org/:_authToken=${NPM_TOKEN}，绝不入库/入包）
.npmrc

# 动态插件打包中间产物（.opencode 下的临时文件）
.opencode/*.txt
.opencode/*.json
.opencode/pack.mjs
